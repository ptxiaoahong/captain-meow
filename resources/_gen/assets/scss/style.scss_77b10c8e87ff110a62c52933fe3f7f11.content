cle-header__category{font-size:var(--text-xs);letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent);font-weight:600}.article-header__title{font-size:var(--text-2xl);line-height:1.3}.article-header__details{display:inline-flex;align-items:center;gap:.6rem;font-size:var(--text-sm);color:var(--color-text-secondary)}.article-content{font-size:var(--text-base);line-height:1.8;color:var(--color-text)}.article-content p{margin:var(--space-3)0}.article-content p:empty{display:none}.article-figure{margin:var(--space-4)0}.article-figure a{display:block;overflow:hidden;border-radius:var(--radius-md);background-color:var(--color-surface);border:1px solid var(--color-border);cursor:zoom-in;transition:box-shadow var(--duration)var(--ease)}.article-figure a:hover{box-shadow:var(--shadow-2)}.article-figure img{width:100%;height:auto;display:block}.article-figure figcaption{margin-top:var(--space-2);font-size:var(--text-sm);color:var(--color-text-tertiary);text-align:center}.comments{margin-top:var(--space-6);padding-top:var(--space-4);border-top:1px solid var(--color-border)}.comments__title{font-size:var(--text-lg);margin-bottom:var(--space-3)}@media(max-width:767px){.article-page .main{padding:0}.article{padding:var(--space-3)0 var(--space-5)}.article-header{padding:0 var(--space-2);margin-bottom:var(--space-3)}.article-header__title{font-size:var(--text-xl)}.article-figure{margin:var(--space-2)0}.article-figure a{border-radius:0;border-left:none;border-right:none}.article-figure figcaption{font-size:var(--text-xs);margin-top:var(--space-1)}}.list-page{padding:var(--space-5)0 var(--space-6)}.list-page__header{margin-bottom:var(--space-4)}.list-page__title{font-size:var(--text-2xl);margin-bottom:var(--space-1)}.list-page__count{font-size:var(--text-sm);color:var(--color-text-secondary)}@media(max-width:767px){.list-page{padding:var(--space-3)0 var(--space-5)}.list-page__title{font-size:var(--text-xl)}}