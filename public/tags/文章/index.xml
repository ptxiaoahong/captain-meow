        <item>
        <title>故事开始后，你也不知道会走向哪里：infj的摄影成人式</title>
        <link>http://localhost:1313/posts/%E6%95%85%E4%BA%8B%E5%BC%80%E5%A7%8B%E5%90%8E%E4%BD%A0%E4%B9%9F%E4%B8%8D%E7%9F%A5%E9%81%93%E4%BC%9A%E8%B5%B0%E5%90%91%E5%93%AA%E9%87%8Cinfj%E7%9A%84%E6%91%84%E5%BD%B1%E6%88%90%E4%BA%BA%E5%BC%8F/</link>
